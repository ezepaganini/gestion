var onbStep = 0;
var onbData = { income:0, incomeDay:1, accounts:[], fixedExpenses:[], monthlySaving:0, goal:null, wantsGoal:false, emergencyMonths:6 };
var ONB_STEPS = 5;

function maybeStartOnboarding(){
  if(!state.config.onboarded){ renderOnboarding(); }
}
function renderOnboarding(){
  var overlay = document.createElement("div");
  overlay.className = "onb-overlay";
  overlay.id = "onbOverlay";
  document.body.appendChild(overlay);
  drawOnbStep();
}
function onbProgressHTML(){
  var s = "";
  for(var i=0;i<ONB_STEPS;i++) s += '<span class="'+(i<=onbStep?"done":"")+'"></span>';
  return '<div class="onb-progress">'+s+'</div>';
}
function drawOnbStep(){
  var overlay = document.getElementById("onbOverlay");
  var html = '<div class="onb-inner">' + onbProgressHTML();
  if(onbStep===0){
    html += '<div class="onb-step"><h2>Empecemos por lo básico</h2><p class="hint">Esto nos ayuda a calcular cuánto podés gastar cada mes.</p>' +
      field("number","onbIncome","¿Cuánto cobrás por mes?", onbData.income||"") +
      field("number","onbIncomeDay","¿Qué día cobrás?", onbData.incomeDay||1) +
    '</div>';
  } else if(onbStep===1){
    html += '<div class="onb-step"><h2>¿Dónde está tu dinero?</h2><p class="hint">Agregá tus cuentas y cuánto tenés en cada una ahora mismo.</p>';
    html += '<div id="onbAccList">' + onbData.accounts.map(function(a,i){
      return '<div class="onb-list-item"><span>'+ACCOUNT_ICONS[a.type]+' '+escapeHTML(a.name)+' — '+fmtMoney(a.amount)+'</span><button class="small-x" data-rmacc="'+i+'">Quitar</button></div>';
    }).join("") + '</div>';
    html += '<div class="field"><label>Nombre de la cuenta</label><input id="onbAccName" placeholder="Ej: Banco Galicia"></div>';
    html += '<div class="field"><label>Tipo</label><select id="onbAccType">' + Object.keys(ACCOUNT_TYPES).map(function(k){return '<option value="'+k+'">'+ACCOUNT_ICONS[k]+' '+ACCOUNT_TYPES[k]+'</option>';}).join("") + '</select></div>';
    html += '<div class="field"><label>Saldo actual</label><input id="onbAccAmount" type="number" placeholder="0"></div>';
    html += '<button class="btn ghost block" id="onbAddAccBtn">'+iconPlus()+' Agregar cuenta</button>';
    html += '</div>';
  } else if(onbStep===2){
    html += '<div class="onb-step"><h2>Tus gastos fijos</h2><p class="hint">Podés agregar los más importantes ahora y sumar el resto después.</p>';
    html += '<div id="onbFxList">' + onbData.fixedExpenses.map(function(f,i){
      return '<div class="onb-list-item"><span>'+escapeHTML(f.name)+' — '+fmtMoney(f.amount)+'</span><button class="small-x" data-rmfx="'+i+'">Quitar</button></div>';
    }).join("") + '</div>';
    html += '<div class="field"><label>Nombre</label><input id="onbFxName" placeholder="Ej: Alquiler"></div>';
    html += '<div class="field"><label>Monto mensual</label><input id="onbFxAmount" type="number" placeholder="0"></div>';
    html += '<button class="btn ghost block" id="onbAddFxBtn">'+iconPlus()+' Agregar gasto fijo</button>';
    html += '</div>';
  } else if(onbStep===3){
    html += '<div class="onb-step"><h2>Tu ahorro y tus objetivos</h2><p class="hint">¿Cuánto te gustaría ahorrar por mes? Si querés, definí un objetivo concreto.</p>' +
      field("number","onbSaving","Ahorro mensual deseado", onbData.monthlySaving||"") +
      '<div class="toggle-row field"><label style="margin:0;">¿Tenés un objetivo en mente?</label><div class="switch '+(onbData.wantsGoal?"on":"")+'" id="onbGoalSwitch"></div></div>' +
      '<div id="onbGoalFields" style="display:'+(onbData.wantsGoal?"block":"none")+';">' +
        field("text","onbGoalName","Nombre del objetivo", onbData.goal?onbData.goal.name:"") +
        field("number","onbGoalTarget","Monto objetivo", onbData.goal?onbData.goal.target:"") +
        field("date","onbGoalDate","Fecha objetivo", onbData.goal?onbData.goal.date:"") +
      '</div>' +
    '</div>';
  } else if(onbStep===4){
    html += '<div class="onb-step"><h2>Fondo de emergencia</h2><p class="hint">Es dinero reservado para imprevistos, calculado en base a tus gastos esenciales.</p>' +
      '<div class="field"><label>Meses de cobertura deseados</label><select id="onbEmergencyMonths">' +
        [3,6,9,12].map(function(m){return '<option value="'+m+'" '+(m===onbData.emergencyMonths?"selected":"")+'>'+m+' meses</option>';}).join("") +
      '</select></div>' +
      '<p class="hint">Vas a poder ver el detalle y ajustar esto más adelante en Más → Fondo de emergencia.</p>' +
    '</div>';
  }
  html += '<div class="onb-nav">' +
    (onbStep>0? '<button class="btn ghost" id="onbBack">Atrás</button>':'') +
    '<button class="btn primary block" id="onbNext">'+(onbStep===ONB_STEPS-1?"Finalizar":"Continuar")+'</button>' +
  '</div>';
  html += '<div class="onb-skip"><button id="onbSkip">Configurar más tarde</button></div>';
  html += '</div>';
  overlay.innerHTML = html;
  bindOnbEvents(overlay);
}
function bindOnbEvents(overlay){
  var back = document.getElementById("onbBack");
  if(back) back.addEventListener("click", function(){ onbStep--; collectOnbStep(); drawOnbStep(); });
  document.getElementById("onbNext").addEventListener("click", function(){
    collectOnbStep();
    if(onbStep<ONB_STEPS-1){ onbStep++; drawOnbStep(); }
    else finishOnboarding();
  });
  document.getElementById("onbSkip").addEventListener("click", function(){
    collectOnbStep();
    finishOnboarding();
  });
  if(onbStep===1){
    document.getElementById("onbAddAccBtn").addEventListener("click", function(){
      var name = document.getElementById("onbAccName").value.trim();
      var type = document.getElementById("onbAccType").value;
      var amount = parseFloat(document.getElementById("onbAccAmount").value)||0;
      if(!name){ showToast("Ingresá un nombre de cuenta."); return; }
      onbData.accounts.push({name:name,type:type,amount:amount});
      drawOnbStep();
    });
    overlay.querySelectorAll("[data-rmacc]").forEach(function(b){
      b.addEventListener("click", function(){ onbData.accounts.splice(parseInt(b.getAttribute("data-rmacc"),10),1); drawOnbStep(); });
    });
  }
  if(onbStep===2){
    document.getElementById("onbAddFxBtn").addEventListener("click", function(){
      var name = document.getElementById("onbFxName").value.trim();
      var amount = parseFloat(document.getElementById("onbFxAmount").value)||0;
      if(!name||amount<=0){ showToast("Completá nombre y monto."); return; }
      onbData.fixedExpenses.push({name:name, amount:amount});
      drawOnbStep();
    });
    overlay.querySelectorAll("[data-rmfx]").forEach(function(b){
      b.addEventListener("click", function(){ onbData.fixedExpenses.splice(parseInt(b.getAttribute("data-rmfx"),10),1); drawOnbStep(); });
    });
  }
  if(onbStep===3){
    document.getElementById("onbGoalSwitch").addEventListener("click", function(){
      onbData.wantsGoal = !onbData.wantsGoal;
      this.classList.toggle("on", onbData.wantsGoal);
      document.getElementById("onbGoalFields").style.display = onbData.wantsGoal?"block":"none";
    });
  }
}
function collectOnbStep(){
  if(onbStep===0){
    var i=document.getElementById("onbIncome"), d=document.getElementById("onbIncomeDay");
    if(i) onbData.income = parseFloat(i.value)||0;
    if(d) onbData.incomeDay = clamp(parseInt(d.value,10)||1,1,31);
  } else if(onbStep===3){
    var s=document.getElementById("onbSaving");
    if(s) onbData.monthlySaving = parseFloat(s.value)||0;
    if(onbData.wantsGoal){
      onbData.goal = {
        name: (document.getElementById("onbGoalName")||{}).value || "Mi objetivo",
        target: parseFloat((document.getElementById("onbGoalTarget")||{}).value)||0,
        date: (document.getElementById("onbGoalDate")||{}).value || ""
      };
    }
  } else if(onbStep===4){
    var em=document.getElementById("onbEmergencyMonths");
    if(em) onbData.emergencyMonths = parseInt(em.value,10);
  }
}
function finishOnboarding(){
  state.config.monthlyIncome = onbData.income||0;
  state.config.incomeDay = onbData.incomeDay||1;
  state.config.emergencyMonths = onbData.emergencyMonths||6;
  state.config.onboarded = true;
  onbData.accounts.forEach(function(a){
    state.accounts.push({id:uid(), name:a.name, type:a.type, initialBalance:a.amount});
  });
  onbData.fixedExpenses.forEach(function(f){
    state.fixedExpenses.push({id:uid(), name:f.name, category:"Otros", amount:f.amount, day:5, active:true});
  });
  if(onbData.wantsGoal && onbData.goal && onbData.goal.target>0){
    state.goals.push({
      id:uid(), name:onbData.goal.name||"Mi objetivo", target:onbData.goal.target, initialCurrent:0,
      targetDate:onbData.goal.date||"", priority:"media", monthlyContribution:onbData.monthlySaving||0
    });
  }
  saveState();
  var overlay = document.getElementById("onbOverlay");
  if(overlay) overlay.remove();
  render();
}

/* =========================================================
   15. INICIO DE LA APLICACION
   ========================================================= */
function startApp(skipOnboardCheck){
  applyTheme();
  render();
  if(!skipOnboardCheck) maybeStartOnboarding();
}
startApp(false);

})();
</script>
