function renderProjChart(){
  var wrap = document.getElementById("projChartWrap");
  if(!wrap) return;
  var aporte = num("projAhorro");
  var rate = num("projRate");
  document.getElementById("projRateVal").textContent = rate+"%";
  var nw = netWorth();
  var horizons = [6,12,24,60];
  var maxMeses = 60;
  var points = [];
  for(var m=0;m<=maxMeses;m+=3){ points.push(futureValue(nw, aporte, m, rate)); }
  var w=300,h=150,pad=8;
  var maxV = Math.max.apply(null, points), minV = Math.min.apply(null, points);
  if(maxV===minV) maxV=minV+1;
  var stepX = (w-pad*2)/(points.length-1);
  var pts = points.map(function(v,i){
    var x = pad+i*stepX;
    var y = h-pad - ((v-minV)/(maxV-minV))*(h-pad*2);
    return x+","+y;
  });
  var svg = '<svg class="projchart" viewBox="0 0 '+w+' '+h+'" preserveAspectRatio="none">' +
    '<path d="M'+pts.join(" L")+'" stroke="var(--primary)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>' +
    '</svg>';
  var stats = horizons.map(function(mm){
    return '<div class="stat"><div class="k">A '+ (mm<12? mm+" meses" : (mm/12)+" año"+(mm/12>1?"s":"")) +'</div><div class="v">'+fmtMoney(futureValue(nw,aporte,mm,rate))+'</div></div>';
  }).join("");
  wrap.innerHTML = svg + '<div class="grid2" style="margin-top:8px;">'+stats+'</div>';
}

