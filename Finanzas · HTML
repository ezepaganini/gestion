document.addEventListener("click", function(e){
  var t = e.target;

  // Navegación de Más
  var masRow = t.closest("[data-mas]");
  if(masRow){ masView = masRow.getAttribute("data-mas"); render(); afterMasRender(); return; }
  if(t.id==="btnBackMas" || t.closest("#btnBackMas")){ masView="menu"; render(); return; }

  // Tabs internas
  var movTab = t.closest("#movFilterTabs button");
  if(movTab){ movFilter = movTab.getAttribute("data-f"); render(); return; }
  var simTab = t.closest("[data-sim]");
  if(simTab){ simView = simTab.getAttribute("data-sim"); render(); bindSimEvents(); return; }

  if(t.id==="fabBtn" || t.closest("#fabBtn")){ openQuickExpense(); return; }
  if(t.id==="btnAddFixed" || t.closest("#btnAddFixed")){ openFixedExpenseModal(); return; }
  if(t.id==="btnAddGoal" || t.closest("#btnAddGoal")){ openGoalModal(); return; }
  if(t.id==="btnGoAccounts" || t.closest("#btnGoAccounts")){ currentTab="mas"; masView="cuentas"; render(); return; }
  if(t.id==="btnAddAccount" || t.closest("#btnAddAccount")){ openAccountModal(); return; }
  if(t.id==="btnTransfer" || t.closest("#btnTransfer")){ openTransferModal(); return; }

  var fixedRow = t.closest("[data-fixed]");
  if(fixedRow){ openFixedExpenseModal(fixedRow.getAttribute("data-fixed")); return; }
  var accRow = t.closest("[data-account]");
  if(accRow && !t.closest("#btnAddAccount")){ openAccountModal(accRow.getAttribute("data-account")); return; }
  var goalCard = t.closest("[data-editgoal]");
  if(goalCard){ openGoalModal(goalCard.getAttribute("data-editgoal")); return; }
  var aportarBtn = t.closest("[data-aportar]");
  if(aportarBtn){ openAporteModal(aportarBtn.getAttribute("data-aportar")); return; }
  var txRowEl = t.closest("[data-tx]");
  if(txRowEl){ openTxDetail(txRowEl.getAttribute("data-tx")); return; }

  if(t.id==="saveBudgetVariable"){ state.budgets.variableBudget = num("budgetVariable"); saveState(); showToast("Presupuesto guardado."); render(); return; }
  if(t.id==="saveCatBudgets"){
    Array.prototype.forEach.call(document.querySelectorAll("[data-catbudget]"), function(inp){
      var v = parseFloat(inp.value);
      if(v>0){ state.budgets.categoryBudgets[inp.getAttribute("data-catbudget")] = v; }
    });
    saveState(); showToast("Presupuestos guardados."); render();
    return;
  }
  if(t.id==="emergencyMonthsSel"){ return; }
  if(t.id==="saveConfig"){
    state.config.monthlyIncome = num("cfgIncome");
    state.config.incomeDay = clamp(num("cfgIncomeDay")||1,1,31);
    state.config.currency = document.getElementById("cfgCurrency").value;
    saveState(); showToast("Configuración guardada."); render();
    return;
  }
  if(t.id==="btnExport"){ exportBackup(); return; }
  if(t.id==="btnImport"){ document.getElementById("importFileInput").click(); return; }
  if(t.id==="btnDemo"){ confirmAction("¿Cargar datos de ejemplo? Esto se sumará a tus datos actuales.", loadDemoData); return; }
  if(t.id==="btnResetAll"){ confirmAction("¿Borrar todos los datos? Esta acción no se puede deshacer.", resetAll); return; }

  var calDay = t.closest("[data-day]");
  if(calDay){ showCalDayDetail(parseInt(calDay.getAttribute("data-day"),10)); return; }
  if(t.id==="calPrev"){ calMonthOffset--; render(); return; }
  if(t.id==="calNext"){ calMonthOffset++; render(); return; }
});
document.addEventListener("change", function(e){
  if(e.target.id==="cfgTheme"){
    state.config.theme = e.target.value; saveState(); applyTheme(); render();
  }
  if(e.target.id==="emergencyMonthsSel"){
