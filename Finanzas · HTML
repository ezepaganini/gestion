<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#EAE6DA">
<title>Mi dinero</title>
<style>
  :root{
    --paper:#EAE6DA;
    --card:#F4F1E7;
    --ink:#1E2A22;
    --ink-soft:#5B6459;
    --line: rgba(30,42,34,0.14);
    --line-strong: rgba(30,42,34,0.28);
    --primary:#2F5D50;
    --primary-soft: rgba(47,93,80,0.12);
    --accent:#B9762E;
    --accent-soft: rgba(185,118,46,0.14);
    --good:#3F7A5D;
    --good-soft: rgba(63,122,93,0.14);
    --bad:#A8433A;
    --bad-soft: rgba(168,67,58,0.13);
    --warn:#B08628;
    --warn-soft: rgba(176,134,40,0.16);
    --radius: 14px;
    --radius-sm: 9px;
    --serif: Georgia, "Iowan Old Style", "Palatino Linotype", "Book Antiqua", serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --nav-h: 64px;
    --safe-bottom: env(safe-area-inset-bottom, 0px);
  }
  html[data-theme="dark"]{
    --paper:#12160F;
    --card:#191F16;
    --ink:#EAE6DA;
    --ink-soft:#9AA394;
    --line: rgba(234,230,218,0.13);
    --line-strong: rgba(234,230,218,0.24);
    --primary:#79B79A;
    --primary-soft: rgba(121,183,154,0.16);
    --accent:#E0A15C;
    --accent-soft: rgba(224,161,92,0.16);
    --good:#7FBF9C;
    --good-soft: rgba(127,191,156,0.14);
    --bad:#D68076;
    --bad-soft: rgba(214,128,118,0.16);
    --warn:#D8B15C;
    --warn-soft: rgba(216,177,92,0.16);
  }
  *{box-sizing:border-box;}
  body{margin:0;}
  html,body{
    background:var(--paper);
    color:var(--ink);
    font-family:var(--sans);
    -webkit-font-smoothing:antialiased;
  }
  #app{
    max-width:560px;
    margin:0 auto;
    min-height:100vh;
    padding-bottom: calc(var(--nav-h) + var(--safe-bottom) + 14px);
    position:relative;
  }
  a{color:inherit;}
  button{font-family:inherit;}
  h1,h2,h3,p{margin:0;}
  .topbar{
    display:flex;align-items:center;justify-content:space-between;
    padding:18px 18px 6px;
  }
  .topbar .greet{font-size:13px;color:var(--ink-soft);}
  .topbar .brand{font-family:var(--serif);font-size:19px;letter-spacing:.2px;}
  .iconbtn{
    width:38px;height:38px;border-radius:50%;border:1px solid var(--line);
    background:var(--card); display:flex;align-items:center;justify-content:center;
    color:var(--ink); cursor:pointer;
  }
  .view{padding:8px 16px 4px;}
  .section-head{
    display:flex; align-items:baseline; justify-content:space-between;
    margin:22px 2px 10px; padding-left:10px; border-left:3px solid var(--accent);
  }
  .section-head h2{font-size:15px; font-weight:600;}
  .section-head .sub{font-size:12px;color:var(--ink-soft);}
  .link-btn{background:none;border:none;color:var(--primary);font-size:13px;cursor:pointer;padding:4px 2px;}

  .card{
    background:var(--card); border:1px solid var(--line); border-radius:var(--radius);
    padding:16px; margin-bottom:12px;
  }
  .card + .card{margin-top:0;}
  .hero{
    background:var(--card); border:1px solid var(--line); border-radius:var(--radius);
    padding:22px 18px; margin-bottom:14px;
  }
  .hero .label{font-size:12.5px;color:var(--ink-soft);}
  .hero .amount{
    font-family:var(--serif); font-size:40px; line-height:1.1; margin:4px 0 14px;
    letter-spacing:-0.5px;
  }
  .chips{display:flex; gap:8px; flex-wrap:wrap;}
  .chip{
    flex:1 1 0; min-width:90px; background:var(--paper); border:1px solid var(--line);
    border-radius:var(--radius-sm); padding:9px 10px;
  }
  .chip .k{font-size:11px;color:var(--ink-soft); display:block; margin-bottom:2px;}
  .chip .v{font-size:15px; font-weight:600; font-variant-numeric: tabular-nums;}

  .daily-card{
    background: linear-gradient(180deg, var(--primary-soft), transparent 80%);
    border:1px solid var(--line); border-radius:var(--radius); padding:16px 18px; margin-bottom:14px;
  }
  .daily-card .big{font-family:var(--serif); font-size:28px; margin:2px 0;}
  .daily-card .foot{font-size:12px; color:var(--ink-soft); margin-top:6px;}

  .row{display:flex; align-items:center; justify-content:space-between; gap:10px;}
  .row + .row{margin-top:10px; padding-top:10px; border-top:1px solid var(--line);}
  .row .left{display:flex; align-items:center; gap:10px; min-width:0;}
  .row .name{font-size:14px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .row .meta{font-size:12px; color:var(--ink-soft);}
  .row .amt{font-size:14.5px; font-weight:600; font-variant-numeric: tabular-nums; white-space:nowrap;}
  .amt.neg{color:var(--bad);}
  .amt.pos{color:var(--good);}
  .dot{width:9px;height:9px;border-radius:50%;flex:none;}

  .bars3{display:flex; gap:16px; align-items:flex-end; height:120px; padding:0 6px;}
  .bars3 .bar-col{flex:1; display:flex; flex-direction:column; align-items:center; gap:8px; height:100%; justify-content:flex-end;}
  .bars3 .bar{width:60%; border-radius:6px 6px 2px 2px; min-height:3px;}
  .bars3 .bar-label{font-size:11px; color:var(--ink-soft); text-align:center;}
  .bars3 .bar-val{font-size:12px; font-weight:600;}

  .progress-track{background:var(--paper); border:1px solid var(--line); border-radius:20px; height:9px; overflow:hidden;}
  .progress-fill{height:100%; border-radius:20px; background:var(--primary);}
  .progress-fill.warn{background:var(--warn);}
  .progress-fill.bad{background:var(--bad);}

  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:6px;
    border-radius:11px; padding:12px 16px; font-size:14.5px; font-weight:600;
    border:1px solid transparent; cursor:pointer;
  }
  .btn.primary{background:var(--primary); color:var(--paper);}
  .btn.ghost{background:transparent; border-color:var(--line-strong); color:var(--ink);}
  .btn.soft{background:var(--primary-soft); color:var(--primary);}
  .btn.danger{background:var(--bad-soft); color:var(--bad);}
  .btn.block{width:100%;}
  .btn:disabled{opacity:.45; cursor:not-allowed;}

  .fab{
    position:fixed; right:calc(50% - 260px + 18px); bottom:calc(var(--nav-h) + var(--safe-bottom) + 16px);
    background:var(--primary); color:var(--paper); border:none; border-radius:50%;
    width:56px;height:56px; font-size:26px; box-shadow:0 6px 16px rgba(0,0,0,.25);
    cursor:pointer; z-index:40; display:flex; align-items:center; justify-content:center;
  }
  @media (max-width:596px){ .fab{ right:18px; } }

  .navbar{
    position:fixed; left:0; right:0; bottom:0; height:calc(var(--nav-h) + var(--safe-bottom));
    padding-bottom:var(--safe-bottom);
    background:var(--card); border-top:1px solid var(--line);
    display:flex; max-width:560px; margin:0 auto; z-index:30;
  }
  .navbar button{
    flex:1; background:none; border:none; display:flex; flex-direction:column; align-items:center;
    justify-content:center; gap:3px; color:var(--ink-soft); font-size:10.5px; cursor:pointer;
  }
  .navbar button svg{opacity:.75;}
  .navbar button.active{color:var(--primary);}
  .navbar button.active svg{opacity:1;}

  .field{margin-bottom:14px;}
  .field label{display:block; font-size:12.5px; color:var(--ink-soft); margin-bottom:6px;}
  .field input, .field select, .field textarea{
    width:100%; padding:11px 12px; border-radius:10px; border:1px solid var(--line-strong);
    background:var(--paper); color:var(--ink); font-size:15px; font-family:inherit;
  }
  .field textarea{resize:vertical; min-height:60px;}
  .amount-input{
    width:100%; border:none; background:none; font-family:var(--serif); font-size:38px;
    text-align:center; color:var(--ink); padding:10px 0; outline:none;
  }
  .chipset{display:flex; flex-wrap:wrap; gap:8px;}
  .chipset .cchip{
    padding:9px 14px; border-radius:20px; border:1px solid var(--line-strong); background:var(--paper);
    font-size:13.5px; cursor:pointer; color:var(--ink);
  }
  .chipset .cchip.sel{background:var(--primary); border-color:var(--primary); color:var(--paper);}
  .toggle-row{display:flex; align-items:center; justify-content:space-between;}
  .switch{position:relative; width:44px; height:26px; border-radius:20px; background:var(--line-strong); cursor:pointer; flex:none;}
  .switch.on{background:var(--primary);}
  .switch .knob{position:absolute; top:3px; left:3px; width:20px; height:20px; border-radius:50%; background:var(--card); transition:left .15s;}
  .switch.on .knob{left:21px;}

  .modal-overlay{
    position:fixed; inset:0; background:rgba(10,14,10,.45); z-index:100;
    display:flex; align-items:flex-end; justify-content:center;
    opacity:0; pointer-events:none; transition:opacity .15s;
  }
  .modal-overlay.open{opacity:1; pointer-events:auto;}
  .modal-sheet{
    background:var(--paper); width:100%; max-width:560px; border-radius:20px 20px 0 0;
    max-height:88vh; overflow-y:auto; padding:10px 18px calc(24px + var(--safe-bottom));
    transform:translateY(16px); transition:transform .15s;
  }
  .modal-overlay.open .modal-sheet{transform:translateY(0);}
  .modal-handle{width:38px; height:4px; background:var(--line-strong); border-radius:4px; margin:8px auto 14px;}
  .modal-title{font-family:var(--serif); font-size:20px; margin-bottom:14px;}
  .modal-actions{display:flex; gap:10px; margin-top:6px;}
  .modal-actions .btn{flex:1;}

  .empty{
    text-align:center; padding:34px 18px; color:var(--ink-soft); font-size:13.5px;
  }
  .empty .btn{margin-top:14px;}

  .tabsel{display:flex; gap:6px; background:var(--card); border:1px solid var(--line); border-radius:12px; padding:4px; margin-bottom:14px; overflow-x:auto;}
  .tabsel button{flex:1; white-space:nowrap; border:none; background:none; padding:9px 10px; border-radius:9px; font-size:12.5px; color:var(--ink-soft); cursor:pointer;}
  .tabsel button.active{background:var(--primary); color:var(--paper); font-weight:600;}

  .grid2{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
  .stat{background:var(--paper); border:1px solid var(--line); border-radius:10px; padding:10px 12px;}
  .stat .k{font-size:11.5px; color:var(--ink-soft);}
  .stat .v{font-size:16px; font-weight:600; margin-top:2px;}

  .alert-item{display:flex; gap:10px; padding:11px 0; border-top:1px solid var(--line); font-size:13px; line-height:1.4;}
  .alert-item:first-child{border-top:none;}
  .alert-item .ai-dot{width:6px;height:6px;border-radius:50%; background:var(--accent); margin-top:6px; flex:none;}

  .menu-list a, .menu-list .mrow{
    display:flex; align-items:center; justify-content:space-between; padding:14px 2px;
    border-top:1px solid var(--line); cursor:pointer; text-decoration:none; color:var(--ink);
  }
  .menu-list .mrow:first-child{border-top:none;}
  .menu-list .mrow .lbl{display:flex; align-items:center; gap:12px; font-size:14.5px;}
  .menu-list .chev{color:var(--ink-soft);}

  .subheader{display:flex; align-items:center; gap:10px; margin:4px 0 14px;}
  .backbtn{background:none;border:none;color:var(--ink);cursor:pointer;padding:6px 4px 6px 0;font-size:20px;}
  .subheader h1{font-family:var(--serif); font-size:21px;}

  .cal-grid{display:grid; grid-template-columns:repeat(7,1fr); gap:5px; margin-bottom:14px;}
  .cal-dow{font-size:10px; text-align:center; color:var(--ink-soft); padding-bottom:3px;}
  .cal-cell{aspect-ratio:1; border-radius:8px; border:1px solid var(--line); display:flex; flex-direction:column; align-items:center; justify-content:center; font-size:12px; position:relative; cursor:pointer; background:var(--card);}
  .cal-cell.today{border-color:var(--primary); border-width:2px;}
  .cal-cell.sel{background:var(--primary-soft);}
  .cal-cell .dots{display:flex; gap:2px; position:absolute; bottom:5px;}
  .cal-cell .dots span{width:4px;height:4px;border-radius:50%;}
  .cal-cell.empty{visibility:hidden; cursor:default;}

  svg.spark{width:100%; height:64px; display:block;}
  svg.projchart{width:100%; height:180px; display:block;}

  .onb-overlay{position:fixed; inset:0; background:var(--paper); z-index:200; overflow-y:auto;}
  .onb-inner{max-width:520px; margin:0 auto; padding:26px 22px calc(30px + var(--safe-bottom)); min-height:100vh; display:flex; flex-direction:column;}
  .onb-progress{display:flex; gap:5px; margin-bottom:24px;}
  .onb-progress span{flex:1; height:4px; border-radius:3px; background:var(--line);}
  .onb-progress span.done{background:var(--primary);}
  .onb-step h2{font-family:var(--serif); font-size:24px; margin-bottom:6px;}
  .onb-step p.hint{font-size:13.5px; color:var(--ink-soft); margin-bottom:20px;}
  .onb-list-item{display:flex; align-items:center; justify-content:space-between; padding:12px 0; border-top:1px solid var(--line);}
  .onb-list-item:first-child{border-top:none;}
  .small-x{background:none;border:none;color:var(--bad);font-size:13px;cursor:pointer;}
  .onb-nav{display:flex; gap:10px; margin-top:auto; padding-top:22px;}
  .onb-skip{text-align:center; margin-top:14px;}
  .onb-skip button{background:none;border:none;color:var(--ink-soft);font-size:12.5px;text-decoration:underline;cursor:pointer;}

  .disclaimer{font-size:11.5px; color:var(--ink-soft); background:var(--paper); border:1px dashed var(--line-strong); border-radius:10px; padding:10px 12px; margin-top:10px; line-height:1.4;}
  .helptext{font-size:12px; color:var(--ink-soft); margin-top:4px;}
  .kv{display:flex; justify-content:space-between; font-size:13.5px; padding:6px 0;}
  .kv .k{color:var(--ink-soft);}
  .kv .v{font-weight:600;}
  .divider{height:1px; background:var(--line); margin:10px 0;}
  input[type="range"]{width:100%;}
  .toast{position:fixed; bottom:calc(var(--nav-h) + var(--safe-bottom) + 14px); left:50%; transform:translateX(-50%); background:var(--ink); color:var(--paper); padding:10px 18px; border-radius:30px; font-size:13px; z-index:150; opacity:0; transition:opacity .2s, transform .2s; pointer-events:none;}
  html[data-theme="dark"] .toast{background:var(--primary); color:#0d120d;}
  .toast.show{opacity:1;}
</style>
</head>
<body>
<div id="app"></div>
<button class="fab" id="fabBtn" aria-label="Registrar gasto" title="Registrar gasto">+</button>
<nav class="navbar" id="navbar"></nav>
<div class="modal-overlay" id="modalOverlay"><div class="modal-sheet" id="modalSheet"></div></div>
<div class="toast" id="toast"></div>

<script>
(function(){
"use strict";

/* =========================================================
   1. ESTADO Y ALMACENAMIENTO
   ========================================================= */
var STORAGE_KEY = "finanzas_app_v1";
var DEFAULT_CATEGORIES = ["Comida","Transporte","Ocio","Compras","Salud","Hogar","Otros"];

function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,8); }
function todayISO(){ return new Date().toISOString().slice(0,10); }

function defaultState(){
  return {
    config:{
      currency:"ARS",
      theme:"auto",
      onboarded:false,
      monthlyIncome:0,
      incomeDay:1,
      emergencyMonths:6
    },
    categories: DEFAULT_CATEGORIES.slice(),
    accounts:[],
    fixedExpenses:[],
    goals:[],
    transactions:[],
    budgets:{ variableBudget:0, categoryBudgets:{} }
  };
}

var state = loadState();

function loadState(){
  try{
    var raw = localStorage.getItem(STORAGE_KEY);
    if(!raw) return defaultState();
    var parsed = JSON.parse(raw);
    var d = defaultState();
    return {
      config: Object.assign({}, d.config, parsed.config||{}),
      categories: parsed.categories && parsed.categories.length ? parsed.categories : d.categories,
      accounts: parsed.accounts || [],
      fixedExpenses: parsed.fixedExpenses || [],
      goals: parsed.goals || [],
      transactions: parsed.transactions || [],
      budgets: Object.assign({variableBudget:0,categoryBudgets:{}}, parsed.budgets||{})
    };
  }catch(e){
    console.error("Error al cargar datos", e);
    return defaultState();
  }
}

function saveState(){
  try{
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }catch(e){
    console.error("Error al guardar datos", e);
    showToast("No se pudo guardar. Verificá el espacio de almacenamiento.");
  }
}

/* =========================================================
   2. UTILIDADES: MONEDA, FECHAS, FORMATO
   ========================================================= */
function fmtMoney(n){
  n = Number(n)||0;
  var cur = state.config.currency || "ARS";
  var locale = cur === "ARS" ? "es-AR" : (cur==="USD" ? "en-US" : (cur==="EUR" ? "es-ES" : "es-AR"));
  try{
    return new Intl.NumberFormat(locale, {style:"currency", currency:cur, maximumFractionDigits:0}).format(n);
  }catch(e){
    return (n<0?"-":"") + cur + " " + Math.abs(Math.round(n)).toLocaleString("es-AR");
  }
}
function fmtNum(n){ return Number(n||0).toLocaleString("es-AR", {maximumFractionDigits:0}); }
function fmtPct(n){ return (Math.round(n*10)/10) + "%"; }
function fmtDateHuman(iso){
  if(!iso) return "";
  var d = new Date(iso+"T00:00:00");
  return d.toLocaleDateString("es-AR", {day:"numeric", month:"short", year:"numeric"});
}
function fmtMonthYear(y,m){
  var d = new Date(y, m, 1);
  var s = d.toLocaleDateString("es-AR", {month:"long", year:"numeric"});
  return s.charAt(0).toUpperCase()+s.slice(1);
}
function monthKey(d){ return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0"); }
function daysInMonth(y,m){ return new Date(y, m+1, 0).getDate(); }
function addMonths(date, n){ var d = new Date(date); d.setMonth(d.getMonth()+n); return d; }
function monthsBetween(a,b){
  return (b.getFullYear()-a.getFullYear())*12 + (b.getMonth()-a.getMonth()) + (b.getDate()>=a.getDate()?0:-1);
}
function clamp(n,min,max){ return Math.max(min, Math.min(max,n)); }

var ACCOUNT_TYPES = {
  banco:"Cuenta bancaria", efectivo:"Efectivo", billetera:"Billetera virtual",
  inversion:"Inversiones", otro:"Otros"
};
var ACCOUNT_ICONS = { banco:"🏦", efectivo:"💵", billetera:"📱", inversion:"📈", otro:"💰" };

/* =========================================================
   3. CALCULOS FINANCIEROS
   ========================================================= */
function computeAccountBalance(accId){
  var acc = state.accounts.find(function(a){return a.id===accId;});
  if(!acc) return 0;
  var bal = acc.initialBalance||0;
  state.transactions.forEach(function(t){
    if(t.type==="ingreso" && t.accountId===accId) bal += t.amount;
    else if(t.type==="gasto" && t.accountId===accId) bal -= t.amount;
    else if(t.type==="transferencia"){
      if(t.accountId===accId) bal -= t.amount;
      if(t.toAccountId===accId) bal += t.amount;
    }
    else if(t.type==="aporte" && t.accountId===accId) bal -= t.amount;
    else if(t.type==="retiro" && t.toAccountId===accId) bal += t.amount;
  });
  return bal;
}
function computeGoalCurrent(goalId){
  var g = state.goals.find(function(x){return x.id===goalId;});
  if(!g) return 0;
  var cur = g.initialCurrent||0;
  state.transactions.forEach(function(t){
    if(t.type==="aporte" && t.goalId===goalId) cur += t.amount;
    else if(t.type==="retiro" && t.goalId===goalId) cur -= t.amount;
  });
  return cur;
}
function allAccountBalances(){
  var map = {};
  state.accounts.forEach(function(a){ map[a.id]=computeAccountBalance(a.id); });
  return map;
}
function totalAccounts(balMap, excludeType){
  return state.accounts.reduce(function(sum,a){
    if(excludeType && a.type===excludeType) return sum;
    return sum + (balMap[a.id]||0);
  },0);
}
function sumByType(balMap, type){
  return state.accounts.filter(function(a){return a.type===type;})
    .reduce(function(s,a){return s+(balMap[a.id]||0);},0);
}
function totalGoalsCurrent(){
  return state.goals.reduce(function(s,g){return s+computeGoalCurrent(g.id);},0);
}
function netWorth(){
  var bal = allAccountBalances();
  return totalAccounts(bal,null) + totalGoalsCurrent();
}
function fixedExpensesTotal(onlyActive){
  return state.fixedExpenses.filter(function(f){return onlyActive?f.active:true;})
    .reduce(function(s,f){return s+f.amount;},0);
}
function goalsMonthlyPlan(){
  return state.goals.reduce(function(s,g){return s+(g.monthlyContribution||0);},0);
}
function txInMonth(y,m,filterFn){
  return state.transactions.filter(function(t){
    var d = new Date(t.date+"T00:00:00");
    return d.getFullYear()===y && d.getMonth()===m && (filterFn?filterFn(t):true);
  });
}
function monthSummary(y,m){
  var ingresos = txInMonth(y,m,function(t){return t.type==="ingreso";}).reduce(function(s,t){return s+t.amount;},0);
  var expectedIncome = state.config.monthlyIncome||0;
  var ingresosEsperados = Math.max(ingresos, expectedIncome);
  var gastosVariables = txInMonth(y,m,function(t){return t.type==="gasto" && t.subtype!=="extraordinario";}).reduce(function(s,t){return s+t.amount;},0);
  var gastosExtra = txInMonth(y,m,function(t){return t.type==="gasto" && t.subtype==="extraordinario";}).reduce(function(s,t){return s+t.amount;},0);
  var gastosFijos = fixedExpensesTotal(true);
  var ahorro = txInMonth(y,m,function(t){return t.type==="aporte";}).reduce(function(s,t){return s+t.amount;},0);
  var retiros = txInMonth(y,m,function(t){return t.type==="retiro";}).reduce(function(s,t){return s+t.amount;},0);
  return {
    ingresos: ingresosEsperados,
    ingresosReales: ingresos,
    gastosVariables: gastosVariables,
    gastosExtra: gastosExtra,
    gastosFijos: gastosFijos,
    gastoTotal: gastosVariables+gastosExtra+gastosFijos,
    ahorro: ahorro - retiros,
    tasaAhorro: ingresosEsperados>0 ? ((ahorro-retiros)/ingresosEsperados*100) : 0
  };
}
function currentVariableBudget(){
  var ms = monthSummary(new Date().getFullYear(), new Date().getMonth());
  if(state.budgets.variableBudget>0) return state.budgets.variableBudget;
  var margen = ms.ingresos - ms.gastosFijos - goalsMonthlyPlan();
  return Math.max(0, margen);
}
function dailyBudgetInfo(){
  var now = new Date();
  var y=now.getFullYear(), m=now.getMonth();
  var ms = monthSummary(y,m);
  var variableBudget = currentVariableBudget();
  var restante = variableBudget - ms.gastosVariables;
  var dim = daysInMonth(y,m);
  var diasRestantes = dim - now.getDate() + 1;
  var diario = diasRestantes>0 ? restante/diasRestantes : restante;
  return { variableBudget:variableBudget, gastado:ms.gastosVariables, restante:restante, diasRestantes:diasRestantes, diario:diario };
}
function netWorthAtDate(cutoffISO){
  var cutoff = new Date(cutoffISO+"T23:59:59");
  var balMap = {};
  state.accounts.forEach(function(a){
    var bal = a.initialBalance||0;
    state.transactions.forEach(function(t){
      var d = new Date(t.date+"T00:00:00");
      if(d>cutoff) return;
      if(t.type==="ingreso" && t.accountId===a.id) bal += t.amount;
      else if(t.type==="gasto" && t.accountId===a.id) bal -= t.amount;
      else if(t.type==="transferencia"){
        if(t.accountId===a.id) bal -= t.amount;
        if(t.toAccountId===a.id) bal += t.amount;
      }
      else if(t.type==="aporte" && t.accountId===a.id) bal -= t.amount;
      else if(t.type==="retiro" && t.toAccountId===a.id) bal += t.amount;
    });
    balMap[a.id]=bal;
  });
  var goalsTotal = 0;
  state.goals.forEach(function(g){
    var cur = g.initialCurrent||0;
    state.transactions.forEach(function(t){
      var d = new Date(t.date+"T00:00:00");
      if(d>cutoff) return;
      if(t.type==="aporte" && t.goalId===g.id) cur += t.amount;
      else if(t.type==="retiro" && t.goalId===g.id) cur -= t.amount;
    });
    goalsTotal += cur;
  });
  var accTotal = 0;
  for(var k in balMap) accTotal += balMap[k];
  return accTotal + goalsTotal;
}
function netWorthEvolution(months){
  var out = [];
  var now = new Date();
  for(var i=months-1;i>=0;i--){
    var d = addMonths(now, -i);
    var y=d.getFullYear(), m=d.getMonth();
    var isCurrent = (i===0);
    var cutoff = isCurrent ? todayISO() : new Date(y,m+1,0).toISOString().slice(0,10);
    out.push({ label: d.toLocaleDateString("es-AR",{month:"short"}), value: netWorthAtDate(cutoff) });
  }
  return out;
}
function essentialMonthlyExpenses(){
  return fixedExpensesTotal(true) + (currentVariableBudget()*0.6);
}
function emergencyFundInfo(){
  var months = state.config.emergencyMonths||6;
  var essential = essentialMonthlyExpenses();
  var target = essential*months;
  var bal = allAccountBalances();
  var current = totalAccounts(bal,"inversion");
  return { months:months, essential:essential, target:target, current:current, faltante:Math.max(0,target-current) };
}
function computeAlerts(){
  var alerts = [];
  var now = new Date();
  var ms = monthSummary(now.getFullYear(), now.getMonth());
  var prev = monthSummary(addMonths(now,-1).getFullYear(), addMonths(now,-1).getMonth());
  if(prev.gastosVariables>0 && ms.gastosVariables > prev.gastosVariables*1.12){
    var diff = Math.round((ms.gastosVariables/prev.gastosVariables-1)*100);
    alerts.push("Este mes estás gastando " + diff + "% más que el mes pasado en gastos variables.");
  }
  if(ms.ingresos>0){
    var pctFijos = ms.gastosFijos/ms.ingresos*100;
    if(pctFijos>40){
      alerts.push("Tus gastos fijos representan el " + Math.round(pctFijos) + "% de tus ingresos.");
    }
  }
  var db = dailyBudgetInfo();
  if(db.diasRestantes>0){
    alerts.push("Este mes todavía podés gastar aproximadamente " + fmtMoney(Math.max(0,db.diario)) + " por día sin exceder tu presupuesto variable.");
  }
  state.goals.forEach(function(g){
    if(!g.monthlyContribution) return;
    var cur = computeGoalCurrent(g.id);
    var faltante = g.target-cur;
    if(faltante<=0) return;
    var mesesConAporte = Math.ceil(faltante/g.monthlyContribution);
    if(g.targetDate){
      var mesesHastaFecha = monthsBetween(now, new Date(g.targetDate+"T00:00:00"));
      if(mesesHastaFecha>0 && mesesConAporte < mesesHastaFecha-1){
        alerts.push("Si mantenés tu ritmo de ahorro, alcanzarías \"" + g.name + "\" antes de lo previsto.");
      } else if(mesesHastaFecha>0 && mesesConAporte > mesesHastaFecha){
        alerts.push("Con el aporte actual, \"" + g.name + "\" se retrasaría respecto a la fecha objetivo.");
      }
    }
  });
  return alerts;
}

