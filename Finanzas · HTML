function exportBackup(){
  var blob = new Blob([JSON.stringify(state,null,2)], {type:"application/json"});
  var url = URL.createObjectURL(blob);
  var a = document.createElement("a");
  a.href = url; a.download = "finanzas-backup-"+todayISO()+".json";
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(function(){URL.revokeObjectURL(url);}, 2000);
  showToast("Backup exportado.");
}
function importBackup(file){
  var reader = new FileReader();
  reader.onload = function(){
    try{
      var data = JSON.parse(reader.result);
      if(!data || typeof data!=="object") throw new Error("formato inválido");
      confirmAction("¿Reemplazar todos los datos actuales con el backup importado?", function(){
        var d = defaultState();
        state = {
          config: Object.assign({}, d.config, data.config||{}),
          categories: data.categories && data.categories.length ? data.categories : d.categories,
          accounts: data.accounts || [],
          fixedExpenses: data.fixedExpenses || [],
          goals: data.goals || [],
          transactions: data.transactions || [],
          budgets: Object.assign({variableBudget:0,categoryBudgets:{}}, data.budgets||{})
        };
        saveState(); applyTheme(); showToast("Backup importado."); render();
      });
    }catch(e){
      showToast("El archivo no es un backup válido.");
    }
  };
  reader.readAsText(file);
}
function resetAll(){
  state = defaultState();
  saveState();
  showToast("Datos borrados.");
  startApp(true);
}
