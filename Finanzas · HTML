function renderCalendario(){
  var now = new Date();
  var view = addMonths(now, calMonthOffset);
  var y = view.getFullYear(), m = view.getMonth();
  var dim = daysInMonth(y,m);
  var firstDow = new Date(y,m,1).getDay();
  var html = subHeader("Calendario financiero");
  html += '<div class="view">';
  html += '<div class="row" style="border:none; margin-bottom:10px;">' +
    '<button class="link-btn" id="calPrev">‹ anterior</button>' +
    '<strong style="font-family:var(--serif);">'+fmtMonthYear(y,m)+'</strong>' +
    '<button class="link-btn" id="calNext">siguiente ›</button></div>';
  html += '<div class="cal-grid">';
  ["D","L","M","M","J","V","S"].forEach(function(d){ html += '<div class="cal-dow">'+d+'</div>'; });
  for(var i=0;i<firstDow;i++) html += '<div class="cal-cell empty"></div>';
  var events = calendarEventsForMonth(y,m);
  for(var d=1; d<=dim; d++){
    var evs = events[d]||[];
    var isToday = (y===now.getFullYear() && m===now.getMonth() && d===now.getDate());
    html += '<div class="cal-cell '+(isToday?"today":"")+'" data-day="'+d+'">'+d +
      (evs.length? '<div class="dots">'+evs.slice(0,3).map(function(e){return '<span style="background:'+e.color+';"></span>';}).join("")+'</div>' : '') +
    '</div>';
  }
  html += '</div>';
  html += '<div class="card" id="calDayDetail"><div class="empty" style="padding:12px;">Tocá un día para ver los detalles.</div></div>';
  html += '</div>';
  return html;
}
function calendarEventsForMonth(y,m){
  var map = {};
  function push(d,text,color){ if(!map[d]) map[d]=[]; map[d].push({text:text,color:color}); }
  if(state.config.incomeDay){ push(clamp(state.config.incomeDay,1,daysInMonth(y,m)), "Día de cobro estimado", "var(--good)"); }
  state.fixedExpenses.filter(function(f){return f.active;}).forEach(function(f){
    push(clamp(f.day,1,daysInMonth(y,m)), f.name+" · "+fmtMoney(f.amount), "var(--bad)");
  });
  state.goals.forEach(function(g){
    if(g.targetDate){
      var d = new Date(g.targetDate+"T00:00:00");
      if(d.getFullYear()===y && d.getMonth()===m) push(d.getDate(), "Meta: "+g.name, "var(--accent)");
    }
  });
  return map;
}

