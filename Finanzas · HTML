function bindSimEvents(){
  var t = document.getElementById("calcObjetivo");
  if(t) t.addEventListener("click", function(){
    var monto = num("simObjMonto"), actual = num("simObjActual"), fecha = document.getElementById("simObjFecha").value;
    var out = document.getElementById("resObjetivo");
    if(!fecha || monto<=0){ out.innerHTML = '<div class="helptext">Completá el monto y la fecha objetivo.</div>'; return; }
    var now = new Date(); var target = new Date(fecha+"T00:00:00");
    var meses = Math.max(1, monthsBetween(now,target));
    var faltante = Math.max(0, monto-actual);
    var mensual = faltante/meses;
    out.innerHTML = kvBlock([
      ["Faltan", fmtMoney(faltante)],
      ["Meses restantes", meses],
      ["Ahorro mensual necesario", fmtMoney(mensual)],
      ["Ahorro semanal necesario", fmtMoney(mensual*12/52)],
      ["Ahorro diario necesario", fmtMoney(mensual*12/365)]
    ]);
  });
  var p = document.getElementById("calcProyeccion");
  if(p) p.addEventListener("click", function(){
    var cap = num("simProyCapital"), aporte = num("simProyAporte"), meses = Math.max(1,num("simProyMeses"));
    var out = document.getElementById("resProyeccion");
    var escenarios = [["Sin rendimiento",0],["Conservador (3% anual)",3],["Moderado (6% anual)",6],["Optimista (10% anual)",10]];
    out.innerHTML = '<div class="divider"></div>' + escenarios.map(function(e){
      var fv = futureValue(cap, aporte, meses, e[1]);
      return '<div class="kv"><span class="k">'+e[0]+'</span><span class="v">'+fmtMoney(fv)+'</span></div>';
    }).join("");
  });
  var pr = document.getElementById("calcProgresivo");
  if(pr) pr.addEventListener("click", function(){
    var aporte = num("simProgAporte"), pct = num("simProgPct"), cada = Math.max(1,num("simProgCada")), meses = Math.max(1,num("simProgMeses"));
    var total = 0, cur = aporte;
    for(var i=1;i<=meses;i++){
      total += cur;
      if(i%cada===0) cur = cur*(1+pct/100);
    }
    var out = document.getElementById("resProgresivo");
    out.innerHTML = kvBlock([
      ["Total acumulado en "+meses+" meses", fmtMoney(total)],
      ["Aporte final estimado", fmtMoney(cur)]
    ]);
  });
  var c = document.getElementById("calcCompra");
  if(c) c.addEventListener("click", function(){
    var monto = num("simCompraMonto");
    var goalId = document.getElementById("simCompraGoal").value;
    var out = document.getElementById("resCompra");
    var nw = netWorth();
    var nwAfter = nw - monto;
    var html = '<div class="divider"></div>' + kvBlock([
      ["Patrimonio actual", fmtMoney(nw)],
      ["Patrimonio después de comprar", fmtMoney(nwAfter)]
    ]);
    if(goalId){
      var g = state.goals.find(function(x){return x.id===goalId;});
      if(g){
        var cur = computeGoalCurrent(g.id);
        var curAfter = Math.max(0, cur-monto);
        var mensual = g.monthlyContribution||0;
        var mesesAntes = mensual>0 ? Math.ceil(Math.max(0,g.target-cur)/mensual) : null;
        var mesesDespues = mensual>0 ? Math.ceil(Math.max(0,g.target-curAfter)/mensual) : null;
        html += '<div class="divider"></div>' + kvBlock([
          [g.name+" — antes", fmtMoney(cur)],
          [g.name+" — después", fmtMoney(curAfter)],
          ["Tiempo estimado antes", mesesAntes!==null ? mesesAntes+" meses" : "—"],
          ["Tiempo estimado después", mesesDespues!==null ? mesesDespues+" meses" : "—"]
        ]);
      }
    }
    out.innerHTML = html;
  });
  var tm = document.getElementById("calcTiempo");
  if(tm) tm.addEventListener("click", function(){
    var monto = num("simTMonto"), actual = num("simTActual"), aporte = num("simTAporte");
    var out = document.getElementById("resTiempo");
    if(aporte<=0){ out.innerHTML='<div class="helptext">El aporte mensual debe ser mayor a cero.</div>'; return; }
    var faltante = Math.max(0, monto-actual);
    var meses = Math.ceil(faltante/aporte);
    var years = Math.floor(meses/12), rem = meses%12;
    out.innerHTML = kvBlock([
      ["Faltan", fmtMoney(faltante)],
      ["Meses necesarios", meses],
      ["Equivalente", years+" años y "+rem+" meses"]
    ]);
  });
}
function num(id){ var el=document.getElementById(id); return el?(parseFloat(el.value)||0):0; }
function kvBlock(pairs){
  return '<div class="divider"></div>' + pairs.map(function(p){
    return '<div class="kv"><span class="k">'+p[0]+'</span><span class="v">'+p[1]+'</span></div>';
  }).join("");
}
function futureValue(capital, aporte, meses, tasaAnual){
  var r = (tasaAnual/100)/12;
  if(r===0) return capital + aporte*meses;
  return capital*Math.pow(1+r,meses) + aporte*((Math.pow(1+r,meses)-1)/r);
}

