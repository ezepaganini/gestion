function barCol(label, val, max, color){
  var h = max>0 ? clamp(val/max*100,2,100) : 2;
  return '<div class="bar-col"><div class="bar-val">'+fmtMoney(val)+'</div><div class="bar" style="height:'+h+'%; background:'+color+';"></div><div class="bar-label">'+label+'</div></div>';
}
function sparkSVG(evo){
  var w=300,h=64,pad=6;
  var vals = evo.map(function(e){return e.value;});
  var min = Math.min.apply(null, vals), max = Math.max.apply(null, vals);
  if(min===max){ min-=1; max+=1; }
  var stepX = (w-pad*2)/(evo.length-1);
  var pts = evo.map(function(e,i){
    var x = pad + i*stepX;
    var y = h-pad - ( (e.value-min)/(max-min) )*(h-pad*2);
    return x+","+y;
  });
  var path = "M"+pts.join(" L");
  var lastUp = evo[evo.length-1].value >= evo[0].value;
  var color = lastUp ? "var(--good)" : "var(--bad)";
  var labels = evo.map(function(e,i){
    var x = pad+i*stepX;
    return '<text x="'+x+'" y="'+(h-1)+'" font-size="8" fill="var(--ink-soft)" text-anchor="middle">'+e.label+'</text>';
  }).join("");
  return '<svg class="spark" viewBox="0 0 '+w+' '+(h+12)+'" preserveAspectRatio="none">' +
    '<path d="'+path+'" stroke="'+color+'" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>' +
    '<circle cx="'+pts[pts.length-1].split(",")[0]+'" cy="'+pts[pts.length-1].split(",")[1]+'" r="3" fill="'+color+'"/>' +
    '</svg>';
}
